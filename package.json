{
  "name": "analysis-idle-v2",
  "private": true,
  "version": "0.3.0-v2-natural-numbers",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --configLoader runner",
    "build": "vite build --config vite.config.ts --configLoader runner",
    "preview": "vite preview --config vite.config.ts --configLoader runner",
    "format": "prettier --write src tools/simulator tools/phase1 tools/phase2 tests v2 reports/phase-1 reports/phase-2 vite.config.ts vitest.config.ts eslint.config.js tsconfig.json package.json",
    "format:check": "prettier --check src tools/simulator tools/phase1 tools/phase2 tests v2 reports/phase-1 reports/phase-2 vite.config.ts vitest.config.ts eslint.config.js tsconfig.json package.json",
    "lint": "eslint src tools/simulator tools/phase1 tools/phase2 tests vite.config.ts vitest.config.ts && node tools/phase1/validate-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run tests/unit --configLoader runner",
    "test:integration": "vitest run tests/integration --configLoader runner",
    "test:determinism": "vitest run tests/determinism tests/simulator --configLoader runner",
    "test:persistence": "vitest run tests/persistence --configLoader runner",
    "test:content": "vitest run tests/content --configLoader runner",
    "test:ui": "vitest run tests/ui --configLoader runner",
    "test:accessibility": "vitest run tests/accessibility --configLoader runner",
    "content:validate": "tsx tools/phase1/content-validate.ts",
    "simulate": "tsx tools/simulator/cli/index.ts",
    "balance:report": "tsx tools/simulator/reports/generate.ts",
    "save:fixtures": "tsx tools/phase1/save-fixtures.ts && prettier --write tests/fixtures/saves reports/phase-1/data/save-fixtures.json",
    "report:phase1": "tsx tools/phase1/generate-reports.ts && prettier --write reports/phase-1",
    "report:phase1-review": "tsx tools/phase1/generate-review-reports.ts && prettier --write reports/phase-1/review",
    "playtest:fixtures": "tsx tools/phase2/playtest-fixtures.ts",
    "phase2:canonicalize": "prettier --write reports/phase-1/data/content-validation.json reports/phase-1/data/balance-and-policy.json reports/phase-1/generated/simulator",
    "screenshots:fixtures": "tsx tools/phase2/screenshot-fixtures.ts",
    "screenshots": "node tools/phase2/validate-screenshots.mjs",
    "artifact:validate": "tsx tools/phase2/validate-artifacts.ts",
    "exact-build:smoke": "node tools/phase2/exact-build-smoke.mjs",
    "report:phase2": "tsx tools/phase2/generate-reports.ts && prettier --write reports/phase-2",
    "phase2:all": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run content:validate && npm run simulate && npm run balance:report && npm run phase2:canonicalize && npm run playtest:fixtures && npm run build && npm run artifact:validate && npm run exact-build:smoke && npm run screenshots && npm run report:phase2",
    "ci": "npm run phase2:all && npm run phase0:all",
    "phase0:audit": "node tools/design-lab/generate-legacy-baseline.mjs",
    "phase0:simulate": "tsx experiments/run.ts --only core-loop,attention,resources",
    "phase0:attention": "tsx experiments/run.ts --only attention",
    "phase0:resources": "tsx experiments/run.ts --only resources",
    "phase0:branches": "tsx experiments/run.ts --only branches",
    "phase0:pacing": "tsx experiments/run.ts --only pacing,active-idle",
    "phase0:offline": "tsx experiments/run.ts --only offline",
    "phase0:prestige": "tsx experiments/run.ts --only prestige",
    "phase0:benchmark": "tsx experiments/run.ts --only frontend,numerical",
    "phase0:prototype": "node tools/design-lab/validate-prototypes.mjs",
    "phase0:screenshots": "node tools/design-lab/validate-screenshots.mjs",
    "phase0:links": "node tools/design-lab/validate-links.mjs",
    "phase0:reconciliation": "node tools/design-lab/generate-reconciliation-report.mjs",
    "phase0:report": "npm run phase0:audit && tsx experiments/run.ts --write && npm run phase0:reconciliation",
    "phase0:repeat": "tsx tools/design-lab/repeatability.ts",
    "phase0:validate": "node tools/design-lab/validate-format.mjs && node tools/design-lab/validate-artifacts.mjs --lint && tsc -p tsconfig.phase0.json --noEmit && vitest run experiments --configLoader runner && npm run phase0:prototype && npm run phase0:screenshots && npm run phase0:links",
    "phase0:all": "npm run phase0:report && npm run phase0:repeat && npm run phase0:validate"
  },
  "dependencies": {
    "preact": "10.29.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
